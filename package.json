{
  "name": "@p-sebastian/react-native-sf-symbol",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "description": "A typed iOS SF Symbol view for Expo and React Native.",
  "type": "module",
  "main": "build/index.js",
  "module": "build/index.js",
  "react-native": "build/index.js",
  "types": "build/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "ios",
    "expo-module.config.json",
    "ReactNativeSFSymbol.podspec",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "consumer:build": "bun scripts/build-consumer.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && bun --cwd apps/example typecheck",
    "test": "bun test src/sf-symbol.test.ts scripts/release-version.test.ts && swift test",
    "pack:inspect": "bun scripts/inspect-pack.ts",
    "release:prepare": "bun scripts/prepare-release.ts"
  },
  "keywords": [
    "expo",
    "ios",
    "react-native",
    "sf-symbols"
  ],
  "author": "Sebastian Peñafiel (@p-sebastian)",
  "contributors": [],
  "license": "MIT",
  "homepage": "https://github.com/p-sebastian/react-native-sf-symbol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-sebastian/react-native-sf-symbol.git"
  },
  "bugs": {
    "url": "https://github.com/p-sebastian/react-native-sf-symbol/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "sf-symbols-typescript": "2.2.0"
  },
  "peerDependencies": {
    "expo": ">=57 <58",
    "react": ">=19.2 <20",
    "react-native": ">=0.86 <0.87"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "expo": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  }
}
